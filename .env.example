# Copy to .env (cp .env.example .env). Validated by packages/shared/src/config.
# Defaults below match docker-compose.yml for local development.

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# PostgreSQL 16
DATABASE_URL=postgres://domik:domik@localhost:5432/domik

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# S3-compatible storage (RustFS locally, Hetzner Object Storage in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central
S3_BUCKET=domik
S3_ACCESS_KEY_ID=domik
S3_SECRET_ACCESS_KEY=domik-s3-secret
S3_FORCE_PATH_STYLE=true

# SMTP (Mailpit locally, Brevo in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Domik <no-reply@domik.local>"

# Worker
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_OUTBOX_POLL_INTERVAL_MS=5000
WORKER_AUCTION_TICK_MS=1000
WORKER_POST_AUCTION_INTERVAL_MS=30000

# Seed (dev only; optional)
# SEED_PASSWORD=Domik-geslo-2026

# EU DSS signature validation (pnpm dss:up). Production: only qualified signatures (QES).
DSS_URL=http://localhost:8089
# Development only: accept signatures made with test certificates (pnpm sign-test-pdf).
SIGNATURE_REQUIRE_QUALIFIED=false
