# Staging env for docker-compose.staging.yml. Copy to .env.staging on the VPS (never commit it).
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d

# Image tag from ghcr.io: `main` (latest main build) or `sha-<short>` to pin / roll back.
IMAGE_TAG=main

# Hostnames: sslip.io resolves <anything>.49.12.206.130.sslip.io to 49.12.206.130 (no DNS setup).
# Switch to a real domain later by changing these three lines.
APP_HOST=drazbe.49.12.206.130.sslip.io
S3_HOST=s3.49.12.206.130.sslip.io
MAIL_HOST=mail.49.12.206.130.sslip.io

# Existing Traefik on the VPS (see docs/deploy-staging.md for how to look these up).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Postgres (runs in this stack). Hex only: openssl rand -hex 24 (goes into a URL unencoded).
POSTGRES_PASSWORD=CHANGE_ME

# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME

# RustFS (S3) credentials; openssl rand -hex 16 / -hex 32
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# Login for the test inbox at https://MAIL_HOST, format user:password
MAILPIT_UI_AUTH=test:CHANGE_ME

# Password for the seeded test accounts (min 10 chars)
SEED_PASSWORD=CHANGE_ME
